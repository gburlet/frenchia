# Copied to .env by `just setup`. Values of __GENERATE__ are replaced with random secrets.
# .env is gitignored: it holds local credentials only.

# PostgreSQL (container "db"; published on 127.0.0.1 only)
POSTGRES_DB=frenchia
POSTGRES_USER=frenchia
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_HOST_PORT=5435

# Django
DJANGO_SECRET_KEY=__GENERATE__
DJANGO_DEBUG=true
DJANGO_LOG_LEVEL=INFO

# The single local learner (also the Django Admin superuser)
FRENCHIA_ADMIN_USERNAME=learner
FRENCHIA_ADMIN_EMAIL=learner@localhost
FRENCHIA_ADMIN_PASSWORD=__GENERATE__

# Host ports (bound to 127.0.0.1)
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# Set to true if Vite misses file changes on the bind mount
VITE_USE_POLLING=false

# Native inference services (launchd agents on this Mac, reached from Docker via
# host.docker.internal; both bind to 127.0.0.1 only). See docs/adr/0002-llm-model.md.
INFERENCE_LLM_BASE_URL=http://host.docker.internal:11435/v1
INFERENCE_LLM_MODEL=gemma4:12b-it-qat
INFERENCE_TTS_BASE_URL=http://host.docker.internal:8791
# Content generation (lessons, banks, review extras): "local" uses the LLM above, "remote" an
# OpenAI-compatible server such as the Alliance's gpt-oss-120b (key: never commit it).
AUTHORING_LLM=local
# AUTHORING_LLM_BASE_URL=https://inference.vulcan.alliancecan.ca/v1
# AUTHORING_LLM_MODEL=gpt-oss-120b
# AUTHORING_LLM_API_KEY=
# Generation workers (more than 1 only makes sense with a remote AUTHORING_LLM)
# WORKER_REPLICAS=1
# Optional: where Ollama keeps models (default ~/.ollama/models)
# OLLAMA_MODELS=~/.ollama/models
# TTS service overrides (see services/tts/README.md), e.g. TTS_PORT=8791
