# Copied to .env by `just setup`. Values of __GENERATE__ are replaced with random secrets.
# .env is gitignored: it holds local credentials only.

# PostgreSQL (container "db"; published on 127.0.0.1 only)
POSTGRES_DB=frenchia
POSTGRES_USER=frenchia
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_HOST_PORT=5435

# Django
DJANGO_SECRET_KEY=__GENERATE__
DJANGO_DEBUG=true
DJANGO_LOG_LEVEL=INFO

# The single local learner (also the Django Admin superuser)
FRENCHIA_ADMIN_USERNAME=learner
FRENCHIA_ADMIN_EMAIL=learner@localhost
FRENCHIA_ADMIN_PASSWORD=__GENERATE__

# Host ports (bound to 127.0.0.1)
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# Set to true if Vite misses file changes on the bind mount
VITE_USE_POLLING=false
