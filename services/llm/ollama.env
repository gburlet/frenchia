# Environment for Frenchia's own Ollama instance (rendered into its launchd agent).
# Loopback only, a non-default port so it never collides with a global Ollama on 11434.
OLLAMA_HOST=127.0.0.1:11435
# Local inference only: disables remote/cloud models and web search.
OLLAMA_NO_CLOUD=1
# One model resident at a time on 16 GB; serialize requests.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
# Long enough not to unload mid-study; the app also pings /api/llm/warm when it opens.
OLLAMA_KEEP_ALIVE=2h
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_FLASH_ATTENTION=1
