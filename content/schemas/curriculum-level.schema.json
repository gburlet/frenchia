          },
          "title": "Grammar Topics",
          "type": "array"
        },
        "vocabulary_theme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vocabulary Theme"
        },
        "prerequisites": {
          "default": [],
          "items": {
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Prerequisites",
          "type": "array"
        },
        "quebec_focus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quebec Focus"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "objectives"
      ],
      "title": "LessonOutline",
      "type": "object"
    },
    "Unit": {
      "additionalProperties": false,
      "properties": {
