      "maximum": 90,
      "minimum": 5,
      "title": "Estimated Minutes",
      "type": "integer"
    },
    "sections": {
      "items": {
        "discriminator": {
          "mapping": {
            "examples": "#/$defs/ExamplesSection",
            "explanation": "#/$defs/ExplanationSection",
            "reading": "#/$defs/ReadingSection",
            "regional_note": "#/$defs/RegionalNoteSection",
            "table": "#/$defs/TableSection",
            "vocabulary": "#/$defs/VocabularySection"
