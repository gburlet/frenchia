          {
            "$ref": "#/$defs/ExplanationSection"
          },
          {
            "$ref": "#/$defs/ExamplesSection"
          },
          {
            "$ref": "#/$defs/TableSection"
          },
          {
            "$ref": "#/$defs/VocabularySection"
          },
          {
            "$ref": "#/$defs/ReadingSection"
          },
          {
            "$ref": "#/$defs/RegionalNoteSection"
