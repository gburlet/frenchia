        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "reading_id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Reading Id",
          "type": "string"
